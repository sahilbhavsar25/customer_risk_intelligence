APP_NAME=Customer Risk Intelligence
APP_ENV=development
DEBUG=false

# PostgreSQL. In docker compose DATABASE_HOST is overridden to "postgres".
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=customer_risk_db
DATABASE_USER=customer_risk_user
DATABASE_PASSWORD=change-me

# OpenAI (gpt-4o-mini + text-embedding-3-small)
OPENAI_API_KEY=

# Qdrant. In docker compose QDRANT_URL is overridden to http://qdrant:6333.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Host ports used by docker compose (change if already taken locally)
API_PORT=8000
POSTGRES_HOST_PORT=5432
QDRANT_HOST_PORT=6333
